# ── Luvstor Admin (independent service) ─────────────────────────────
# Same MongoDB as the main backend. Use a DB user with readWrite on the app DB.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/luvstor

# Secret for admin sessions. Must be different from the app's JWT_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# Main backend base URL + its ADMIN_API_KEY (used for actions that must run
# the app's own logic: photo verification, reports, tickets, push).
MAIN_API_URL=https://luvstor-api.onrender.com
MAIN_ADMIN_API_KEY=

# Where profile photos are served from (defaults to MAIN_API_URL)
# MEDIA_BASE_URL=https://luvstor-api.onrender.com

# Optional — enables the Money → Payments / Revenue views (read-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=4000
NODE_ENV=production
# 1 on Render / behind one proxy so client IPs and secure cookies work
TRUST_PROXY=1
# Session length in hours
ADMIN_SESSION_HOURS=8
