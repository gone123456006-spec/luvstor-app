PORT=5000
NODE_ENV=development

# ── Render production ─────────────────────────────────────────────────────
# Render sets PORT and NODE_ENV=production automatically.
# Set these in Render Dashboard → Environment (never commit real secrets):
#
#   MONGODB_URI=mongodb+srv://...          (Atlas — allow 0.0.0.0/0 in Network Access)
#   JWT_SECRET=<random 64+ chars>          (Render can auto-generate)
#   REDIS_URL=<from Render Redis add-on>   (required for WebSockets at scale)
#   FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of Firebase JSON>
#   GOOGLE_WEB_CLIENT_ID=...
#   GOOGLE_ANDROID_CLIENT_ID=...
#   SMTP_* (Brevo)
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET (if using payments)
#
# After deploy, set in frontend/.env before building APK:
#   EXPO_PUBLIC_API_URL=https://luvstor-api.onrender.com
#
# Render health check: GET /health (liveness)
# Keep-alive ping:       GET /ping (cron every 60s, header X-Heartbeat-Secret)
# Full readiness:        GET /ready (mongo + redis)
# HEARTBEAT_SECRET=       Auto-generated by render.yaml (shared with cron job)
# HEARTBEAT_TARGET_URL=   Optional override for local: node scripts/renderHeartbeat.js

# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/luvstor
# Atlas (replace <db_password>):
MONGODB_URI=mongodb+srv://luvstorapps_db_user:<db_password>@luvstorapps.gjrecui.mongodb.net/luvstor?retryWrites=true&w=majority&appName=luvstorapps
# Raise for multi-million user clusters (Atlas / self-hosted)
MONGO_POOL_SIZE=100
JWT_SECRET=change_this_to_a_long_random_secret

# ── Horizontal scale (required for 1M+ / multi-instance) ──────────────────
# Leave unset for single-process local dev. For production set a Redis URL:
# REDIS_URL=redis://default:password@your-redis-host:6379
# Enables: Socket.IO adapter, BullMQ push queue, shared presence + chat-view.
# REDIS_URL=
PUSH_CONCURRENCY=20
PUSH_MAX_ATTEMPTS=5
PUSH_BACKOFF_MS=2000
PUSH_MAX_QUEUE=100000
# Auto-delete read notifications after N days (0 = never)
NOTIFICATION_TTL_DAYS=90
# CORS_ORIGIN=https://your-app.com

# ── Nearby discovery (7-day fresh rotation) ───────────────────────────────
# Timezone the rotation day flips in, in minutes (330 = IST, 0 = UTC).
# Server-side only, so a wrong device clock can never shift someone's rotation.
DISCOVERY_ROTATION_TZ_OFFSET_MINUTES=0
# How long per-viewer "who have I already seen" history is kept.
DISCOVERY_HISTORY_RETENTION_DAYS=90
# Optional hard ceiling on discovery distance. Unset keeps today's behaviour:
# the chosen radius decides who is "nearby", and people beyond it are still
# offered once nearby supply runs out. Set it to make the radius a strict limit.
# DISCOVERY_MAX_RADIUS_METRES=
# How long "who viewed my profile" is kept (feeds the daily digest).
PROFILE_VIEW_RETENTION_DAYS=90

# ── Daily suggestion digest ───────────────────────────────────────────────
# One push per user per day summarising new likes, matches, profile visits and
# new people nearby. Users who have nothing waiting are never messaged.
DAILY_SUGGESTIONS_ENABLED=true
# Local hour (0-23) the digest goes out, in the timezone below.
DAILY_SUGGESTION_HOUR=18
DAILY_SUGGESTION_TZ_OFFSET_MINUTES=0
# Skip accounts idle for longer than this.
DAILY_SUGGESTION_ACTIVE_DAYS=30
# Window for counting new likes, matches and profile visits.
DAILY_SUGGESTION_LOOKBACK_HOURS=24
# Window for counting "new people joined near you".
DAILY_SUGGESTION_NEW_JOINER_DAYS=7
# Cap on the geo lookups used for nearby counts, per run.
DAILY_SUGGESTION_MAX_NEARBY=2000

# ── SMTP — Brevo (OTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b734e7001@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM_NAME=Luvstor
# Must be verified in Brevo → Senders. Prefer a custom domain for Gmail delivery.
SMTP_FROM_EMAIL=luvstorapps@gmail.com

SMTP_DEV_MODE=false

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# ── Firebase (FCM push + Google Sign-In) ──────────────────────────────────
# Download service account JSON from Firebase Console → Project settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=./config/your-project-firebase-adminsdk-xxxxx.json

# Google Sign-In OAuth client IDs (from Firebase / Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=

PUSH_CUSTOM_SOUNDS=false

ADMIN_API_KEY=

# ── WebRTC calling (STUN + optional TURN for NAT traversal) ─────────────
# Comma-separated STUN URLs (defaults to Google public STUN if unset)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Production: add a TURN provider (Metered / Twilio / coturn) — required on many mobile networks
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# CALL_RING_TIMEOUT_MS=45000
# CALL_HEARTBEAT_TIMEOUT_MS=25000
