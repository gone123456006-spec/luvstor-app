# Copy to frontend/.env and fill from Firebase Console → Project settings → Your apps (Web)
# Also create OAuth clients: Google Cloud Console → APIs & Services → Credentials

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=dating-app-fb5c4.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=dating-app-fb5c4
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=dating-app-fb5c4.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web client ID (required) — Firebase → Authentication → Sign-in method → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android OAuth client (package: com.luvstor.app)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS OAuth client (bundle: com.luvstor.app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: backend URL override for physical devices / production APK
# EXPO_PUBLIC_DEV_LAN_IP=192.168.1.10
# EXPO_PUBLIC_API_PORT=5001

# Media for /uploads (DP, cover, posts).
# Leave unset in local Metro — media loads from the same host as the API
# (so photos you upload locally actually appear). Candidates still try
# production as failover for Atlas paths that only exist on Render.
# EXPO_PUBLIC_MEDIA_BASE_URL=https://luvstor-api.onrender.com
#
# Production APK — set in .env.production (or uncomment below before release):
# EXPO_PUBLIC_API_URL=https://luvstor-api.onrender.com
# EXPO_PUBLIC_SHARE_BASE_URL=https://luvstor-api.onrender.com
# EXPO_PUBLIC_MEDIA_BASE_URL=https://luvstor-api.onrender.com
# EXPO_PUBLIC_ONELINK_TEMPLATE_PATH=go

# Local APK build (from frontend/):
#   npm run android:apk
# Output:
#   android/app/build/outputs/apk/release/app-release.apk
#   dist/luvstor-release.apk
