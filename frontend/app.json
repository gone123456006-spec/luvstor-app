{
  "expo": {
    "name": "Luvstor",
    "slug": "luvstor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "luvstor",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/spashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#5A2FC7"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "Luvstor accesses your photo library so you can share images in chat.",
        "NSMicrophoneUsageDescription": "Luvstor uses the microphone for voice messages and voice/video calls.",
        "NSCameraUsageDescription": "Luvstor uses the camera for photos and video calls.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "Luvstor uses your location to show you nearby matches."
      }
    },
    "android": {
      "package": "com.luvstor.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#5A2FC7",
        "foregroundImage": "./assets/images/app-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "luvstor",
              "host": "u"
            },
            {
              "scheme": "luvstor",
              "pathPrefix": "/u"
            },
            {
              "scheme": "luvstor",
              "host": "r"
            },
            {
              "scheme": "luvstor",
              "pathPrefix": "/r"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "luvstor-api.onrender.com",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "luvstor-api.onrender.com",
              "pathPrefix": "/r"
            },
            {
              "scheme": "https",
              "host": "luvstor-api.onrender.com",
              "pathPrefix": "/go"
            },
            {
              "scheme": "http",
              "host": "localhost",
              "pathPrefix": "/u"
            },
            {
              "scheme": "http",
              "host": "localhost",
              "pathPrefix": "/r"
            },
            {
              "scheme": "http",
              "host": "localhost",
              "pathPrefix": "/go"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-dev-client",
      "expo-secure-store",
      "./plugins/withFcmAndroid",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withRazorpay",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Luvstor uses your location to show you nearby matches."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Luvstor uses the microphone for voice messages and voice/video calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Luvstor accesses your photo library so you can share images in chat.",
          "cameraPermission": "Luvstor uses the camera for photos and video calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Luvstor uses the camera for photo verification and video calls.",
          "microphonePermission": "Luvstor uses the microphone for voice messages and voice/video calls.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/withWebRTC",
      "./plugins/withCallForegroundService",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#5A2FC7",
          "defaultChannel": "system",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-task-manager",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/spashscreen.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#5A2FC7",
          "dark": {
            "backgroundColor": "#5A2FC7",
            "image": "./assets/images/spashscreen.png"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.944271155469-crp7cmrsa5fuqqk1moaut0pnj2p462dm"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
