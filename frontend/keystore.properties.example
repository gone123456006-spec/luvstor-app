# Copy to android/keystore.properties (never commit that file).
# Paths are relative to the android/ folder.
#
# Create the keystore first (from frontend/):
#   keytool -genkeypair -v \
#     -storetype PKCS12 \
#     -keystore android/app/luvstor-upload.keystore \
#     -alias luvstor-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill passwords below to match what you typed.

storeFile=app/luvstor-upload.keystore
storePassword=SH@@45
keyAlias=luvstor-upload
keyPassword=SH@@45
